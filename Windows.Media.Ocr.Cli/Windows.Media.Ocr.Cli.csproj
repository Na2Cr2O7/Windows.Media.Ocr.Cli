<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net10.0-windows10.0.19041.0 会自动引入 Windows SDK projection（Microsoft.Windows.SDK.NET.Ref），
      也就是 CsWinRT 生成的 Windows.Media.Ocr / Windows.Graphics.Imaging / Windows.Storage 等 API，
      不再需要 UwpDesktop 包和手工引用 winmd。
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU</Platforms>

    <!-- System.Drawing / 剪贴板（System.Windows.Forms.Clipboard） -->
    <UseWindowsForms>true</UseWindowsForms>

    <RootNamespace>Windows.Media.Ocr.Cli</RootNamespace>
    <AssemblyName>Windows.Media.Ocr.Cli</AssemblyName>
    <StartupObject>Windows.Media.Ocr.Cli.Program</StartupObject>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- 程序集信息由 SDK 生成（含 SupportedOSPlatform 标记，CA1416 平台分析依赖它）。
         原先手写的 Properties\AssemblyInfo.cs 已移除。 -->
    <AssemblyTitle>Windows.Media.Ocr.Cli</AssemblyTitle>
    <Product>Windows.Media.Ocr.Cli</Product>
    <Copyright>Copyright ©  2018</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ComVisible>false</ComVisible>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 程序没有使用这两个资源文件，排除以免和 SDK 默认的资源通配重复 -->
    <Compile Remove="Properties\Resources.Designer.cs" />
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <!-- 旧项目的 RestorePackages / 备份文件不参与编译 -->
    <Compile Remove="**\*.bak" />
    <None Remove="Windows.Media.Ocr.Cli.net48.csproj.bak" />
  </ItemGroup>

</Project>
